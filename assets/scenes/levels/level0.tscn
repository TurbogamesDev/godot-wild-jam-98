[sub_resource type="Shader" id="Shader_04ggp"]
code = "shader_type canvas_item;

uniform sampler2D SCREEN_TEXTURE : hint_screen_texture;

// Light below this brightness shows nothing (fully dark)
uniform float fade_start : hint_range(0.0, 1.0) = 0.0;
// Light at or above this brightness shows the full screen pixel
uniform float fade_end : hint_range(0.0, 1.0) = 1.0;

void light(){
	// min() of the channels means only white-ish light counts,
	// so a colored light won't trigger the reveal
	float brightness = min(LIGHT_COLOR.r, min(LIGHT_COLOR.g, LIGHT_COLOR.b));

	float amount = smoothstep(fade_start, fade_end, brightness);

	LIGHT = vec4(texture(SCREEN_TEXTURE, SCREEN_UV).rgb * amount, 1.0);
}"

